// Declarations for ClinicalScheduler, analyzed on Production. Begun from the suggestions generated
// 2026-10-21 from the schema export, then extended by hand for data integrity findings I2, I3, I7, and I8,
// and for the email columns' format.
{
  // Tables whose names look like backups or dated copies.
  "exclude": [
    "[dbo].[genericFormValueBk]", // name word "bk"
    "[dbo].[manualPrescheduleItemBK_2022_12_30]", // name word "bk" and a date
    "[dbo].[studentSchedule_2020_03_31]", // a date in the name
    "[dbo].[studentSchedule_2022_03_29]", // a date in the name
    "[dbo].[scheduleWithSeq001]" // a dead copy of studentSchedule (finding I10)
  ],

  // For each table, the column that dates its rows, guessed from the column names. Confirm each one.
  "dateColumns": {
    "[dbo].[AdminAudit]": "timestamp", // the only date column
    "[dbo].[BrainStatus]": "LastSnapshot", // the only date column
    "[dbo].[EvolutionIntervalStat]": "Created", // named for creation
    "[dbo].[InstructorSchedule]": "Modified_date", // named for modification
    "[dbo].[ManualPreScheduleItem]": "Create_Date", // named for creation; others: Modified_Date
    "[dbo].[PotentialSchedule]": "DateGenerated", // the only date column
    "[dbo].[RequestAudit]": "ModTime", // named for modification
    "[dbo].[RotationWeeklyPref]": "Modified_Date", // named for modification
    "[dbo].[SNAP_ManualPreScheduleItem]": "Create_Date", // named for creation; others: Modified_Date
    "[dbo].[SNAP_RotationWeeklyPref]": "Modified_Date", // named for modification
    "[dbo].[SNAP_ServiceRequestDetail]": "Create_Date", // named for creation; others: Modified_Date
    "[dbo].[SNAP_ServiceRequest]": "Create_Date", // named for creation; others: Modified_Date
    "[dbo].[ScheduleAudit]": "timestamp", // the only date column
    "[dbo].[ServiceRequestDetail]": "Create_Date", // named for creation; others: Modified_Date
    "[dbo].[ServiceRequest]": "Create_Date", // named for creation; others: Modified_Date
    "[dbo].[Service]": "LastMod", // named for modification
    "[dbo].[StudentTrack]": "Create_Date", // named for creation; others: Modified_Date
    "[dbo].[externalEmailSent]": "timestamp", // the only date column
    "[dbo].[externalEmailTemplate]": "modified", // named for modification
    "[dbo].[externalRequestAudit]": "timestamp", // the only date column
    "[dbo].[externalRequest]": "createdOn", // named for creation; others: approverNotifiedOn, approvalSubmittedOn, lastEditedOn
    "[dbo].[studentExternalNote]": "enteredOn", // named for creation
    "[dbo].[visitor]": "addDate" // named for creation; others: modifyDate
    // Several date columns, none named for creation or modification; pick one if any dates the rows:
    //   [dbo].[EvolutionRunStat]: Started, LastSnapshot, StartedIntervalsAt
    //   [dbo].[Status]: OpenDate, CloseDate, ExtRequestOpen, ExtRequestDeadline, ExtRequestReopen
    //   [dbo].[Week]: DateStart, DateEnd
  },

  // Columns whose values the report may show: the emphasis abbreviations, so the checks below can list
  // the ones that disagree, and the grad years and term codes that key many rows.
  "safeColumns": [
    { "table": "[dbo].[link_PrimEmphasis_ClinEmphasis]", "column": "PrimaryEmphasis", "reason": "Emphasis abbreviations, codes rather than anything personal." },
    { "table": "[dbo].[StudentPrimaryEmphasis]", "column": "PRIMARYEmpasisAbbrev", "reason": "Emphasis abbreviations, codes rather than anything personal." },
    { "table": "[dbo].[PrimaryEmphasis]", "column": "Emphasis_Abbrev", "reason": "Emphasis abbreviations, codes rather than anything personal." },
    { "table": "[dbo].[Status]", "column": "GradYear", "reason": "Graduation years, shared by a whole class." },
    { "table": "[dbo].[StudentDidactic]", "column": "GradYear", "reason": "Graduation years, shared by a whole class." },
    { "table": "[dbo].[StudentTrack]", "column": "GradYear", "reason": "Graduation years, shared by a whole class." },
    { "table": "[dbo].[Track]", "column": "GradYear", "reason": "Graduation years, shared by a whole class." },
    { "table": "[dbo].[Week]", "column": "TermCode", "reason": "Term codes, shared by everyone in a term." },
    { "table": "[dbo].[studentSchedule]", "column": "TermCode", "reason": "Term codes, shared by everyone in a term." }
  ],

