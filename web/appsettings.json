{
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "System": "Warning"
        }
    },
    "LoggingPath": "C:\\nlog", //TODO - change to production logging location,
    "AllowedHosts": "*",
    "PhotoGallery": {
        "IDCardPhotoPath": "S:\\Files\\IDCardPhotos\\",
        "DefaultPhotoFile": "nopic.jpg",
        "CacheDurationHours": "24"
    },
    "IPAddressAllowlistConfiguration": {
        "InternalAllowlist": [
            "::1", // IPv6 localhost
            "127.0.0.1", // IPv4 localhost
            "192.168.33.2", // Benjamin
            "192.168.32.172", // Brandon
            "192.168.33.1", // Jason
            "192.168.32.195", // Keith
            "192.168.32.253" // Rex
        ],
        "ExternalAllowlist": []
    },
    "Cas": {
        "CasBaseUrl": "https://cas.ucdavis.edu/cas/"
    },
    "Authentication": {
        // Which sign-in provider(s) to offer: "Cas", "EntraId", or "Both".
        // Campus is retiring CAS in favor of Entra ID. Default stays CAS so an environment
        // without an explicit override is unaffected; TEST overrides this to "Both".
        "EnabledProviders": "Cas"
    },
    "EntraId": {
        // The UC Davis campus tenant, same in every environment. Not a secret: it is public in
        // the OIDC discovery document at login.microsoftonline.com/ucdavis.edu.
        "TenantId": "a8046f64-66c0-4f00-9046-c8daf92ff62b",
        // ClientId is per-environment (each app registration gets its own) and is not a secret
        // either, since it travels in the browser redirect. ClientSecret must never be committed:
        // it comes from AWS Systems Manager Parameter Store
        // (/{Environment}/EntraId/ClientSecret) in TEST/PROD and from .env.local
        // (EntraId__ClientSecret) locally, same as every other secret in this app.
        "ClientId": "",
        // Relative to the PathBase, so the redirect URI registered for TEST is
        // "https://secure-test.vetmed.ucdavis.edu/2/signin-entra".
        "CallbackPath": "/signin-entra",
        "SignedOutCallbackPath": "/signout-entra",
        // AAUD stores the bare kerberos id, so the "@ucdavis.edu" suffix on
        // preferred_username is stripped. If the onpremisessamaccountname optional claim
        // gets enabled on the app registration, switch LoginIdClaim to it and set
        // StripEmailDomain false.
        "LoginIdClaim": "preferred_username",
        "StripEmailDomain": true
    },
    "EmailNotifications": {
        "PrimaryEvaluatorRemoved": {
            "To": ["lgissvoran@ucdavis.edu"],
            "From": "svmithelp@ucdavis.edu"
        }
    },
    "EffortSettings": {
        "VerificationEmailSubject": "Action required, timely ask - Effort data verification",
        "VerificationReplyDays": 7
    },
    "Hangfire": {
        // Hangfire's tables live in ConnectionStrings:VIPER.
        "Enabled": true
    },
    "Cms": {
        // Gates the cms:trash-purge scheduled job. Keep false until the legacy VIPER 1 30-day
        // trash purge is retired, so the two never purge in parallel. Flip to true (via SSM in
        // deployed envs) at cutover to let the daily job permanently delete files trashed > 30 days ago.
        "TrashPurgeEnabled": false
    }
}
