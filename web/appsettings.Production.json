{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LoggingPath": "s:\\nlog",
  // Only the hostnames this environment is actually reached by. Defence in depth behind
  // Cloudflare/F5/IIS: CAS callbacks come from Application:PublicBaseUrl, not the Host header.
  // secure.vetmed.ucdavis.edu is a second production hostname for the same site, used by the
  // Jenkins post-deploy health check and by legacy VIPER 1 links.
  // localhost is kept so on-server probes and IIS itself are not rejected.
  "AllowedHosts": "viper.vetmed.ucdavis.edu;secure.vetmed.ucdavis.edu;localhost",
  "Application": {
    // Canonical public origin, including the /2 PathBase of the IIS sub-app.
    "PublicBaseUrl": "https://viper.vetmed.ucdavis.edu/2"
  },
  "ConnectionStrings": {
      "AAUD": "",
      "Courses": "",
      "CREST": "",
      "Dictionary": "",
      "Effort": "",
      "EvalHarvest": "",
      "PhoneLists": "",
      "RAPS": "",
      "SIS": "",
      "VIPER": ""
  },
  "Vmacs": {
    "BaseUrl": "https://vmacs-vmth.vetmed.ucdavis.edu"
  },
  "CMS": {
    "LegacyWebrootPath": "S:\\webroot\\https\\viper"
  },
  "EmailSettings": {
    "SmtpHost": "ucdavis-edu.mail.protection.outlook.com",
    "SmtpPort": 25,
    "EnableSsl": true,
    "DefaultFromAddress": "svmithelp@ucdavis.edu",
    "UseMailpit": false
  },
  "Hangfire": {
    "DashboardAppPath": "/2/Computing"
  }
}
