<q-dialog position="top" full-width v-model="showSessionTimeoutWarning" seamless v-cloak>
    <q-card :class="'q-mx-lg ' + (sessionExpired ? 'error-surface' : 'bg-grey-2')">
        <q-card-section class="row items-center no-wrap">
            <q-icon size="md" :name="sessionExpired ? 'error' : 'warning'"
                    :color="sessionExpired ? 'negative' : 'warning'"></q-icon>
            <q-space></q-space>
            <div v-if="sessionExpired">
                Your session has expired. Please log in again.
            </div>
            <div v-else-if="!sessionExpired && !sessionReloaded">
                Your session will expire at {{sessionExpireTime}}. Click Refresh Session to continue working.
            </div>
            <div v-else-if="!sessionExpired">
                Your session has been extended to {{sessionExpireTime}}.
            </div>
            <q-space></q-space>
            <q-btn dense color="secondary" class="q-px-md" label="Log in" v-if="sessionExpired || sessionExtendFailed" @@click="login"></q-btn>
            <q-btn dense color="secondary" class="q-px-md" label="Refresh Session" :loading="sessionExtending" v-if="!sessionExpired && !sessionReloaded" @@click="extendSession"></q-btn>
        </q-card-section>
        <q-card-section v-if="sessionExtendFailed && !sessionExpired" class="q-pt-none">
            <q-banner dense rounded role="alert" class="error-surface">
                Could not extend your session. Please try again.
            </q-banner>
        </q-card-section>
    </q-card>
</q-dialog>

<script asp-add-nonce="true">
    /* global clearTimeout, AbortSignal */
    createVueApp({
        data() {
            return {
                sessionRefreshUrl: '@Html.Raw(ViewData["sessionRefreshUrl"] ?? "")',
                showSessionTimeoutWarning: false,
                sessionExpireTime: 0,
                sessionExpired: false,
                sessionTimeoutCheckEventId: 0,
                sessionPollId: 0,
                sessionDeadline: 0,
                sessionReloaded: false,
                sessionExtendFailed: false,
                sessionExtending: false
            }
        },
        methods: {
            // Timeout so a hung request still rejects instead of stalling the chain.
            fetchJson: function (url) {
                return fetch(url, { signal: AbortSignal.timeout(10000) })
                    .then(r => r.ok ? r.json() : Promise.reject(new Error(url + ' returned ' + r.status)))
            },
            formatTime: function (dateTime) {
                return new Date(dateTime).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })
            },
            checkSessionTimeout: function () {
                // One live timer, and only the newest poll may act: a renewal or later poll makes this one stale.
                clearTimeout(this.sessionTimeoutCheckEventId)
                var pollId = ++this.sessionPollId
                this.fetchJson(this.sessionRefreshUrl)
                    .then(r => {
                        if (pollId !== this.sessionPollId) { return }
                        var s = r.secondsUntilTimeout
                        var nextCheck = 300
                        if (s !== undefined) {
                            this.sessionDeadline = Date.now() + s * 1000
                            // "<=" so an exact 300 still warns: otherwise the next poll lands at expiry.
                            if (s <= 300) {
                                this.showSessionTimeoutWarning = true
                                this.sessionExpired = s < 15
                                this.sessionExpireTime = this.formatTime(r.sessionTimeoutDateTime)
                                nextCheck = this.sessionExpired ? 0 : Math.max(s - 15, 5)
                            } else {
                                // Aim at the five-minute mark so one poll cannot skip the warning.
                                nextCheck = Math.min(300, Math.max(s - 300, 5))
                            }
                        }
                        if (nextCheck > 0) {
                            this.sessionTimeoutCheckEventId = window.setTimeout(this.checkSessionTimeout, nextCheck * 1000)
                        }
                    })
                    // Silent, but reschedule so one failed poll cannot stop checks or sleep through the warning.
                    .catch(() => {
                        if (pollId !== this.sessionPollId) { return }
                        var retry = 300
                        if (this.showSessionTimeoutWarning) {
                            retry = 15
                        } else if (this.sessionDeadline) {
                            retry = Math.min(300, Math.max((this.sessionDeadline - Date.now()) / 1000 - 300, 15))
                        }
                        this.sessionTimeoutCheckEventId = window.setTimeout(this.checkSessionTimeout, retry * 1000)
                    })
            },
            extendSession: function() {
                this.sessionExtendFailed = false
                this.sessionExtending = true
                // "~/" keeps the app's PathBase; a bare "/" resolves to the domain root.
                this.fetchJson('@Url.Content("~/RefreshSession")')
                    .then(r => {
                        this.sessionPollId++
                        clearTimeout(this.sessionTimeoutCheckEventId)
                        this.sessionExpireTime = this.formatTime(r.sessionTimeoutDateTime)
                        // A poll that landed mid-renewal may have marked it expired; the renewal wins.
                        this.sessionExpired = false
                        this.sessionReloaded = true
                        this.sessionTimeoutCheckEventId = window.setTimeout(this.checkSessionTimeout, 5000)

                        window.setTimeout(this.hideSessionTimeoutWarning, 1000)
                    })
                    // Keep the dialog up to retry or log in; skip the banner if it closed, or it greets the next warning.
                    .catch(() => { this.sessionExtendFailed = this.showSessionTimeoutWarning })
                    .finally(() => { this.sessionExtending = false })
            },
            hideSessionTimeoutWarning: function() {
                this.showSessionTimeoutWarning = false
                this.sessionReloaded = false
                this.sessionExtendFailed = false
            },
            login: function() {
                var returnUrl = encodeURIComponent(window.location.pathname + window.location.search)
                window.location = '@Url.Content("~/login")?ReturnUrl=' + returnUrl
            }
        },
        mounted() {
            this.sessionTimeoutCheckEventId = window.setTimeout(this.checkSessionTimeout, 60000)
        }
    })
</script>

