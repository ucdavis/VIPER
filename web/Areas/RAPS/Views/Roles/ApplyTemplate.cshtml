@{
    ViewData["Title"] = "Apply Template";
}
<h1>Apply role template {{roleTemplate.templateName}}</h1>

<q-form>
    Search for a single user, or paste in multiple login ids.
    <div class="row q-mb-sm">
        <q-select outlined dense options-dense clearable use-input input-debounce="300" class="col col-md-4 col-lg-3"
                  label="User" v-model="userSearch" @@filter="findUsers" :options="userSearchResults"></q-select>
        <q-input type="text" class="col col-md-6 col-lg-5 q-ml-sm" outlined debounce="500" dense label="Enter comma separated loginids" v-model="loginids"></q-input>
    </div>
</q-form>

<table cellpadding="2" v-if="membersFound">
    <thead>
        <tr>
            <th class="text-left"><span class="text-h6">Review Changes</span></th>
            <th colspan="2" class="text-right">
                <q-btn label="Apply template to user(s)" color="primary" no-caps :disable="!templateLoaded || isPreviewLoading || isApplying" @@click="applyTemplate" class="q-px-sm q-py-xs"></q-btn>
            </th>
        </tr>
    </thead>
    <tbody>
        <template v-for="member in members">
            <tr>
                <td class="text-weight-bold" colspan="3">{{member.displayName}}</td>
            </tr>
            <tr v-for="role in member.roles">
                <td>
                    <q-icon :name="role.userHasRole ? 'info' : 'add'" :color="role.userHasRole ? 'info' : 'positive'" size="sm"></q-icon>
                    {{role.userHasRole ? 'User has role' : 'Role will be added'}}
                </td>
                <td>{{role.roleName}}</td>
                <td>{{role.description}}</td>
            </tr>
        </template>
    </tbody>
</table>
<div v-if="!membersFound">
    <span v-if="members != null">No matching users found</span>
    <span v-else></span>
</div>
@section Scripts{
    <script src="~/js/qtable.js"></script>
    <script asp-add-nonce="true">
        createVueApp({
            data() {
                return {
                    members: null, //results of previewing the apply action
                    membersFound: false, //show table if a matching user was found
                    roleTemplateId: 0,
                    roleTemplate: {},
                    // Starts false so applying is disabled until the template is read.
                    templateLoaded: false,
                    // Applying is also blocked while a preview is in flight, so the button can
                    // never act on a set of users the table has not finished showing.
                    isPreviewLoading: false,
                    // And while a run is in flight, so a second click cannot start a parallel
                    // run over the same users.
                    isApplying: false,
                    previewRequestId: 0,
                    loginids: "",
                    userSearch: "",
                    userSearchResults: [],
                    VMACSPush: false
                }
            },
            methods: {
                getApplyUrl: function(target) {
                    // Both ids land in the url path, so encode them: a login id is free text
                    // and a stray ? or # would silently truncate the id the server sees.
                    return target.memberId
                        ? `RoleTemplates/${this.roleTemplateId}/Apply/${encodeURIComponent(target.memberId)}`
                        : `RoleTemplates/${this.roleTemplateId}/Apply/loginid:${encodeURIComponent(target.loginId)}`
                },
                // q-select clears to null and models the selection as an option object,
                // so the value has to be dug out rather than tested directly.
                hasSelectedUser: function() {
                    return (this.userSearch?.value?.length ?? 0) > 0
                },
                // The two inputs are mutually exclusive: a picked user wins over the pasted list.
                // Preview and apply share this so both always act on the same set.
                applyTargets: function() {
                    if (this.hasSelectedUser()) {
                        return [{ memberId: this.userSearch.value }]
                    }
                    // Pasted lists carry spaces and a trailing comma; neither is a login id.
                    return (this.loginids ?? "")
                        .split(",")
                        .map(loginId => loginId.trim())
                        .filter(loginId => loginId.length > 0)
                        .map(loginId => ({ loginId: loginId }))
                },
                userSearchUpdate: async function() {
                    this.previewApplyTemplate()
                },
                loginidsUpdate: async function() {
                    if (!this.hasSelectedUser()) {
                        this.previewApplyTemplate()
                    }
                },
                applyTemplate: async function () {
                    const targets = this.applyTargets()
                    if (targets.length === 0) {
                        return
                    }
                    this.isApplying = true
                    try {
                        // viperFetch resolves to undefined on a failed write and has already told
                        // the user why, so only a run where every write landed may report success.
                        let applied = 0
                        for (const target of targets) {
                            const result = await viperFetch(this, this.getApplyUrl(target), {
                                method: "POST",
                                headers: { "Content-Type": "application/json" }
                            })
                            if (result !== undefined) {
                                applied++
                            }
                        }
                        // A failed VMACS push leaves the error dialog up, so it must not be
                        // contradicted by a success toast either.
                        let succeeded = applied === targets.length
                        if (applied > 0 && this.VMACSPush) {
                            succeeded = await this.pushRolesToVMACS() && succeeded
                        }
                        if (succeeded) {
                            showStatusNotification("Role template applied")
                        }
                    } finally {
                        this.isApplying = false
                    }
                    this.previewApplyTemplate()
                },
                pushRolesToVMACS: async function() {
                    const roleIds = this.roleTemplate.roleTemplateRoles.map(rtr => rtr.roleTemplateRoleRoleId)
                    if (roleIds.length === 0) {
                        // VMACSExport drops its role filter on an empty list, so [] would export
                        // every user in the instance instead of none.
                        return true
                    }
                    Quasar.Loading.show({ message: "Updating VMACS" })
                    const result = await viperFetch(this, "Roles/Members/VMACSExport", {
                        method: "POST",
                        body: JSON.stringify(roleIds),
                        headers: { "Content-Type": "application/json" }
                    })
                    Quasar.Loading.hide()
                    if (result === undefined) {
                        // The request itself failed and viperFetch has already reported it.
                        return false
                    }
                    // The wrapper's success flag only reflects the status code, so a push that
                    // failed at VMACS arrives as a 200 carrying success: false. The endpoint's
                    // result is nullable, so check before reading the flag off it.
                    if (result !== null && result.success === false) {
                        this.showViperError = true
                        this.viperErrorMessage = result.errorMessage?.length > 0
                            ? result.errorMessage
                            : "The VMACS update did not complete."
                        return false
                    }
                    return true
                },
                previewApplyTemplate: async function() {
                    // Previews overlap, so stamp each run. A slow earlier one must not land on top
                    // of a newer one and leave the table showing a different user than Apply writes to.
                    const requestId = ++this.previewRequestId
                    this.isPreviewLoading = true
                    try {
                        const targets = this.applyTargets()
                        // The search box wins, so empty the pasted list to match what is being previewed
                        if (this.hasSelectedUser()) {
                            this.loginids = ""
                        }
                        if (targets.length === 0) {
                            if (requestId === this.previewRequestId) {
                                this.members = null
                                this.membersFound = false
                            }
                            return
                        }
                        const previews = []
                        let previewFailed = false
                        for (const target of targets) {
                            // null means no user matched, which the API reports as a normal result.
                            // undefined means the read failed and viperFetch has already reported it.
                            const preview = await viperFetch(this, this.getApplyUrl(target))
                            if (preview === undefined) {
                                // The whole preview is discarded below, so there is nothing to
                                // learn from reading the rest.
                                previewFailed = true
                                break
                            }
                            if (preview !== null) {
                                previews.push(preview)
                            }
                        }
                        if (requestId !== this.previewRequestId) {
                            return
                        }
                        // Apply writes to every target, not only the ones the table lists, so a
                        // preview that did not complete must not leave a table to act on. Leaving
                        // members null keeps "No matching users found" off a read that failed.
                        if (previewFailed) {
                            this.members = null
                            this.membersFound = false
                            return
                        }
                        this.members = previews
                        this.membersFound = previews.length > 0
                    } finally {
                        // Only the newest run may clear the flag. An older one finishing late must
                        // not re-enable Apply while a newer preview is still running.
                        if (requestId === this.previewRequestId) {
                            this.isPreviewLoading = false
                        }
                    }
                },
                findUsers: function (val, update, abort) {
                    if (val.length < 3) {
                        abort()
                        return
                    }
                    update(() => {
                        viperFetch(this, "Members?active=recent&search=" + encodeURIComponent(val))
                            .then(data => {
                                // A failed search resolves to undefined; leave the list empty rather than throwing
                                this.userSearchResults = (data ?? []).map(m => ({
                                    label: (!m.current ? "[Inactive]" : "") + m.displayLastName + ", " + m.displayFirstName,
                                    value: m.memberId
                                }))
                            })
                    })
                }
            },
            async mounted() {
                this.roleTemplateId = this.urlParams.get("roleTemplateId")
                // roleTemplateRoles must be an array: the VMACS push path maps over it.
                // Track load failure separately so an unread template is never mistaken for
                // an empty one, which would push an empty role list to VMACS.
                const template = await viperFetch(this, "RoleTemplates/" + this.roleTemplateId)
                this.templateLoaded = template !== undefined
                this.roleTemplate = template ?? { roleTemplateRoles: [] }
                this.VMACSPush = this.urlPath.indexOf("/VMACS.") > 0
            },
            watch: {
                userSearch: function () {
                    this.userSearchUpdate()
                },
                loginids: function () {
                    this.loginidsUpdate()
                }
            }
        })
    </script>
}
